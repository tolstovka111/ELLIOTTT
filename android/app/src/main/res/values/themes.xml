<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Delta" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/delta_background</item>
        <item name="android:navigationBarColor">@color/delta_background</item>
        <item name="android:windowBackground">@color/delta_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- System splash: the in-app animated splash takes over immediately after. -->
    <style name="Theme.Delta.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/delta_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Delta</item>
    </style>

</resources>
